# Copy to backend/.env and fill in. Never commit .env.

# TWO SEPARATE SERVICES:
#   TinyFish  = web search + page fetch ONLY (never used as an LLM key)
#   LLM       = OpenAI / Google Gemini / Anthropic, for planning, verification, writing, critique
# Without an LLM key the app starts and search works, but autonomous research is blocked
# (you can still run a clearly labelled DEMO MODE — SIMULATED AI session).
# Values here override system environment variables of the same name.

# --- Research (required for live mode) -------------------------------------
# Free key: https://agent.tinyfish.ai/api-keys  (Search + Fetch are free)
TINYFISH_API_KEY=

# --- LLM (required for live mode) ------------------------------------------
# openai | gemini | anthropic | none. If blank and exactly ONE LLM key is set, that provider is used;
# if several keys are set you MUST choose here (the app never switches providers silently).
# Use "none" to ignore any LLM key that exists in your system environment.
LLM_PROVIDER=
# Optional; defaults: openai=gpt-4.1-mini, gemini=gemini-2.5-flash, anthropic=claude-sonnet-4-5
# OpenAI reasoning models (gpt-5*, o3, o4-mini) work too; temperature is omitted automatically
LLM_MODEL=
OPENAI_API_KEY=
# Optional: any OpenAI-compatible endpoint (Groq, OpenRouter, local Ollama /v1 ...)
OPENAI_BASE_URL=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# --- LLM rate limits (all five agents share ONE budget) ------------------------
# Free tiers often allow only ~5-15 requests/min. Keep LLM_MAX_RPM below your plan's limit.
LLM_MAX_RPM=8
LLM_MAX_CONCURRENCY=1
# Temporary errors only (429 rate limit, timeout, 5xx): retries after waiting (Retry-After, else 5-10s, 15-30s).
# Missing/invalid keys and exhausted quota/credits are NEVER retried.
LLM_MAX_RETRIES=2
# If the provider asks to wait longer than this (seconds), stop and show a clear error instead of blocking
LLM_MAX_WAIT_S=90
# TinyFish Search allows 30 requests/min per key by default
TINYFISH_SEARCH_RPM=25

# --- Behaviour ---------------------------------------------------------------
# Set to 1 to make EVERY session DEMO MODE — SIMULATED AI (sample data, no LLM)
DEMO_MODE=0
STAGE_TIMEOUT_S=900
STAGE_MAX_ATTEMPTS=2
LLM_TIMEOUT_S=120
# Research sessions run one at a time by default so they do not compete for the LLM quota
MAX_CONCURRENT_SESSIONS=1
# Resume sessions interrupted by a backend restart (1/0)
AUTO_RESUME=1
# Seconds of pacing per simulated step in DEMO MODE so the agent relay is watchable (0 = instant)
DEMO_DELAY_S=0.6
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DATABASE_PATH=./data/research.db

# --- Testing / proxies only ----------------------------------------------------
# TINYFISH_SEARCH_URL=https://api.search.tinyfish.ai
# TINYFISH_FETCH_URL=https://api.fetch.tinyfish.ai
